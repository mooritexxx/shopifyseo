# CoS-owned cutover secrets. Copy outside the repo, never commit.
# Suggested path: /home/box/.config/shopifyseo/pg.env
# chmod 600
#
# scripts/pg_cutover.sh sources this file into ITS OWN process only.
# scripts/start-app.sh sources it only when the live mark exists
# (/home/box/.config/shopifyseo/pg_live_cutover.json).
# Dev-only ./start_app.sh and scripts/dev-restart-local.sh do not source this file.
#
# DATABASE_URL is required here after scripts/mark-pg-live.sh (the app switch).
# Until then, leave it commented so a stray source cannot flip uvicorn.

# libpq / psql (used by pgloader, psql, and the Python verifiers)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=shopifyseo
# PGPASSWORD=
PGDATABASE=shopifyseo_cutover_dryrun

# Full URL for Python helpers (psycopg). Prefer this over DATABASE_URL so a
# later `source pg.env` cannot flip the live app.
CUTOVER_DATABASE_URL=postgresql://shopifyseo@127.0.0.1:5432/shopifyseo_cutover_dryrun

# SQLite catalog to copy and load FROM (read-only for the live file).
# SQLITE_PATH=/var/lib/shopifyseo/shopify_catalog.sqlite3

# Database name used by --apply-load (still does not set live DATABASE_URL).
# CUTOVER_LIVE_DATABASE=shopifyseo

# Live app URL. Uncomment only after the post-flip sweep, then run
# scripts/mark-pg-live.sh. scripts/start-app.sh sources this when the live
# mark is present and will exit nonzero if it is missing or PG is down.
# DATABASE_URL=postgresql://shopifyseo@127.0.0.1:5432/shopifyseo

# Optional pgloader binary
# PGLOADER=pgloader
